---
import { getLatestRelease } from "../lib/release";

const { variant = "primary", destination = "installer" } = Astro.props as {
  variant?: "primary" | "ghost";
  destination?: "installer" | "releases";
};
const releasesUrl = "https://github.com/coastal-ms/DST-DuneServerTool/releases";
const release = destination === "installer" ? await getLatestRelease() : null;
const primaryHref = release?.installerUrl ?? releasesUrl;
const notesHref = release?.htmlUrl ?? releasesUrl;
const primaryLabel =
  destination === "installer"
    ? "Download latest stable for Windows"
    : "Browse downloads for Windows";
const notesLabel =
  destination === "installer"
    ? "Stable release notes →"
    : "View latest release notes →";
const classes =
  variant === "primary"
    ? "inline-flex items-center gap-2 sm:gap-3 rounded-lg bg-dune-accent hover:bg-dune-accent-soft text-dune-bg text-sm sm:text-base font-medium px-4 sm:px-6 py-3 transition-colors shadow-lg shadow-amber-900/30"
    : "inline-flex items-center gap-2 sm:gap-3 rounded-lg border border-dune-border hover:border-dune-accent text-dune-text text-sm sm:text-base px-4 sm:px-6 py-3 transition-colors";
---

<div class="flex flex-col items-start gap-2">
  <a
    href={primaryHref}
    class={classes}
    rel="noopener"
  >
    <svg
      class="w-5 h-5 shrink-0"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d="M12 3v14m0 0l-5-5m5 5l5-5" stroke-linecap="round" />
      <path d="M5 21h14" stroke-linecap="round" />
    </svg>
    <span>{primaryLabel}</span>
  </a>
  <a
    href={notesHref}
    class="text-xs text-dune-muted hover:text-dune-text underline decoration-dotted"
    rel="noopener"
  >
    {notesLabel}
  </a>
</div>
