---
import Base from "../layouts/Base.astro";
import DownloadButton from "../components/DownloadButton.astro";
import Screenshot from "../components/Screenshot.astro";
import { formatDisplayVersion, getLatestRelease } from "../lib/release";

const base = import.meta.env.BASE_URL;
const release = await getLatestRelease();
const versionLabel = formatDisplayVersion(release.version);

// Latest Funcom Dune: Awakening release this build is verified against.
const funcomVersion = "1.4.10.4";

const features = [
  {
    title: "Operate Self-Hosted without living in a shell",
    body: "Health, maps, INIs, PostgreSQL, backups, players, bases, Landsraad, and the Exchange stay in one Windows app with guarded actions and clear recovery paths.",
  },
  {
    title: "Manage a local Solo save safely",
    body: "Solo Mode validates one local save and keeps backup-first tools for settings, inventory, currencies, cosmetics, packages, vehicle kits, augments, and proven progression.",
  },
  {
    title: "See the Deep Desert before it shifts",
    body: "DD Seed Maps puts all 12 Coriolis layouts inside DST with POI filters, confidence notes, seed selection, and running-map seed detection.",
  },
];
---

<Base
  title="DST — Dune Server Tool"
  description="A Windows operations app for Dune: Awakening Self-Hosted servers and local Solo saves. Open source, Apache 2.0."
>
  <section class="mx-auto max-w-6xl px-6 pt-20 pb-12">
    <div class="grid lg:grid-cols-[1.1fr_1fr] gap-12 items-center">
      <div>
        <div
          class="font-mono text-xs uppercase tracking-widest text-dune-accent mb-3"
        >
          Open source · Apache 2.0 · {versionLabel}
        </div>
        <div
          class="inline-flex items-center gap-2 rounded-full border border-emerald-500/40 bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-300 mb-5"
        >
          <span aria-hidden="true">✅</span>
          Verified compatible with Dune: Awakening {funcomVersion}
        </div>
        <h1
          class="text-5xl sm:text-6xl font-semibold tracking-tight leading-[1.05]"
        >
          Run Dune your way,
          <span class="text-dune-accent">without the YAML.</span>
        </h1>
        <p class="mt-6 text-lg text-dune-muted leading-relaxed max-w-xl">
          DST is a single-window Windows app for Dune: Awakening Self-Hosted
          servers and local Solo saves. It puts Hyper-V, K3s, PostgreSQL,
          configuration, backups, gameplay administration, and save tools
          behind deliberate controls instead of terminal archaeology.
        </p>
        <div class="mt-8 flex flex-wrap items-start gap-4">
          <DownloadButton />
          <a
            href={`${base}features`}
            class="inline-flex items-center gap-2 rounded-lg border border-dune-border hover:border-dune-accent text-dune-text px-6 py-3 transition-colors"
          >
            See features →
          </a>
        </div>
      </div>
      <Screenshot
        src={`${base}screenshots/server-health.png`}
        alt="Server Health dashboard showing battlegroup status, ports, game servers, and active spice fields"
      />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid sm:grid-cols-3 gap-6">
      {
        features.map((f) => (
          <div class="border-t border-dune-border pt-5">
            <h3 class="text-lg font-semibold text-dune-text mb-2">{f.title}</h3>
            <p class="text-sm text-dune-muted leading-relaxed">{f.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div
      class="rounded-xl border border-dune-border bg-dune-surface p-8 sm:p-12"
    >
      <h2 class="text-2xl sm:text-3xl font-semibold mb-4">
        What's in the box
      </h2>
      <div class="grid sm:grid-cols-2 gap-x-12 gap-y-3 text-dune-muted">
        <div>✓ VM, battlegroup, pod, port, memory, and spice health</div>
        <div>✓ Curated Game Config plus isolated Experimental Lab</div>
        <div>✓ Local-client Game.ini and opt-in Engine.ini management</div>
        <div>✓ Gameplay Admin for players, bases, storage, blueprints, and Landsraad</div>
        <div>✓ Duke Market Bot with formula and market-follow pricing</div>
        <div>✓ Packages, vehicle kits, cosmetics, progression, and base-water tools</div>
        <div>✓ Interactive DD Seed Maps for all 12 Coriolis layouts</div>
        <div>✓ Solo Mode with validated, backup-first offline mutations</div>
        <div>✓ PostgreSQL backup, restore, SQL, migration, and cleanup workflows</div>
        <div>✓ Three-path setup, including Hyper-V over LAN</div>
        <div>✓ Constrained remote portal and mobile pairing</div>
        <div>✓ Scheduled restarts, updater, startup, and background service options</div>
      </div>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href={`${base}install`}
          class="inline-flex items-center gap-2 text-dune-accent hover:text-dune-accent-soft"
        >
          Install guide →
        </a>
        <a
          href="https://github.com/coastal-ms/DST-DuneServerTool"
          rel="noopener"
          class="inline-flex items-center gap-2 text-dune-muted hover:text-dune-text"
        >
          Browse the code →
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-20">
    <div
      class="rounded-xl border border-dune-accent/40 bg-dune-accent/5 p-8 sm:p-12 sm:flex sm:items-center sm:justify-between gap-8"
    >
      <div>
        <h2 class="text-2xl sm:text-3xl font-semibold mb-3">
          Join the DST community
        </h2>
        <p class="text-dune-muted leading-relaxed max-w-2xl">
          The <strong class="text-dune-text">DST community Discord</strong> is the
          place to go for help — install &amp; setup, hosting and networking
          questions, Game Config &amp; Landsraad tips, and chat with other
          self-hosters. New releases are announced there too.
        </p>
      </div>
      <div class="mt-6 sm:mt-0 shrink-0">
        <a
          href="https://discord.gg/tj2x7cywSC"
          rel="noopener"
          target="_blank"
          class="inline-flex items-center gap-2 rounded-lg bg-dune-accent hover:bg-dune-accent-soft text-dune-bg font-medium px-6 py-3 transition-colors"
        >
          Join the Discord →
        </a>
      </div>
    </div>
  </section>
</Base>
