---
import Base from "../layouts/Base.astro";
import DownloadButton from "../components/DownloadButton.astro";
import Screenshot from "../components/Screenshot.astro";
import DuneHorizon from "../components/DuneHorizon.astro";

const base = import.meta.env.BASE_URL;
---

<Base
  title="DST — Your Dune world, under your command"
  description="Run a Dune: Awakening Self-Hosted server or manage a supported local Solo save. Discover v15's optional Command Deck, static DD Atlas, and responsive Browser Portal."
>
  <section class="desert-hero">
    <DuneHorizon />
    <div class="site-width hero-content">
      <h1>Your world.<br /><span>Under your command.</span></h1>
      <p class="hero-intro">
        From your first sietch to a server full of friends.
        Dune Server Tool brings server operations, gameplay administration,
        and local Solo saves into one Windows app.
      </p>
      <div class="hero-actions">
        <DownloadButton destination="releases" />
        <a href={`${base}features`} class="text-link">Explore v15 <span aria-hidden="true">↗</span></a>
      </div>
      <p class="hero-footnote">Open source. Apache 2.0. Classic by default. Command Deck by choice.</p>
    </div>
  </section>

  <section class="site-width showcase" aria-labelledby="deck-heading">
    <div class="section-heading">
      <div>
        <h2 id="deck-heading">A wider view of your world.</h2>
        <p>Meet Command Deck: an opt-in World dashboard with focused workspaces and your essential tools in the bottom dock.</p>
      </div>
      <a href={`${base}features#command-deck`} class="text-link">Tour Command Deck <span aria-hidden="true">↗</span></a>
    </div>
    <Screenshot
      src={`${base}screenshots/command-deck.png`}
      alt="Command Deck's World view with its Arrakis globe, status summary, and bottom dock including DD Atlas, Solo Mode, Players, and Bases"
      caption="v15 World view, captured offline. The globe is a navigation and status workspace, not a live geographical map; no map instances are connected here."
      eager
    />
    <div class="deck-footnotes">
      <p><strong>Keep the familiar.</strong> Classic remains the default. Choose <strong>Try Command Deck</strong> in the status bar; return with <strong>Classic</strong>.</p>
      <p><strong>Go straight to the task.</strong> Manage a player, open Bases → Blueprints, or browse Commands by category. No new workflow to install.</p>
    </div>
  </section>

  <section class="atlas-section">
    <div class="site-width atlas-layout">
      <div class="atlas-copy">
        <h2>The desert shifts.<br />Bring an atlas.</h2>
        <p>Explore the twelve Deep Desert Coriolis layouts, with sector grids, points of interest, filters, and confidence notes.</p>
        <p>The <strong>DD Atlas</strong> shortcut opens the shipped static reference. It does not track live players, resources, or world changes.</p>
        <a href={`${base}features#maps`} class="text-link">Read the terrain <span aria-hidden="true">↗</span></a>
      </div>
      <Screenshot
        src={`${base}screenshots/dd-seed-maps.png`}
        alt="Shipped static DD Atlas showing seed zero's sector grid and filters for wrecks, testing stations, caves, spice, taxis, and ore"
        caption="Static seed 0 reference. Current server seed is unavailable in this offline capture."
      />
    </div>
  </section>

  <section class="site-width operating-paths" aria-labelledby="paths-heading">
    <h2 id="paths-heading">One tool. Your way to play.</h2>
    <div class="path-columns">
      <article>
        <h3>Host a world</h3>
        <p>Watch server health, adjust Game Config, and look after players, bases, and the economy. Backups, read-only SQL defaults, and explicit warnings put consequential work in context.</p>
        <a href={`${base}install`} class="text-link">Set up Self-Hosted <span aria-hidden="true">↗</span></a>
      </article>
      <article>
        <h3>Keep it Solo</h3>
        <p>No VM required. Inspect a supported local Solo save, retain backups, and manage settings, inventory, and progression. Save edits require the game to be closed.</p>
        <a href={`${base}features#solo`} class="text-link">See Solo Mode <span aria-hidden="true">↗</span></a>
      </article>
      <article>
        <h3>Step away from the desk</h3>
        <p>Use the responsive Browser Portal on a phone, tablet, or PC. Tailscale Funnel is the recommended transport, with host-created Owner and Admin accounts.</p>
        <a href={`${base}remote`} class="text-link">Open the remote guide <span aria-hidden="true">↗</span></a>
      </article>
    </div>
    <p class="surface-note">Local-only by default. Existing Cloudflare configuration is retained; its legacy portal stays disabled until explicitly re-enabled in local Settings.</p>
  </section>

  <section class="site-width community-strip">
    <div>
      <h2>No one has to host alone.</h2>
      <p>Setup help, practical advice, and other Dune: Awakening self-hosters. Find your people in the DST community.</p>
    </div>
    <a href="https://discord.gg/tj2x7cywSC" rel="noopener" target="_blank" class="action-link">Join the Discord <span aria-hidden="true">↗</span></a>
  </section>
</Base>
