---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import Screenshot from "../components/Screenshot.astro";

const base = import.meta.env.BASE_URL;

const sections = [
  {
    id: "health",
    title: "Server Health",
    img: "server-health.png",
    body: "See the VM, battlegroup, database, gateway, director, game pods, public ports, active spice fields, scheduled restarts, and memory-pressure warnings in one place. Health cards distinguish normal reconciliation from actual faults, while raw output and log exports remain close when you need evidence.",
  },
  {
    id: "gameconfig",
    title: "Game Config",
    img: "game-config.png",
    body: "Edit UserGame.ini and UserEngine.ini through typed controls instead of hand-editing files. DST reads live values, shows Funcom defaults, creates restore points, writes isolated managed blocks, and can mirror opted-in settings to the local client. Proven controls stay in Game Config; recovered, unconfirmed controls live separately in Experimental Lab.",
  },
  {
    id: "gameplay",
    title: "Gameplay Admin",
    img: "gameplay-admin.png",
    body: "Manage players, bases, storage, blueprints, Landsraad Houses, the Exchange, and Duke's Market Bot from one console. Player actions cover currencies, items, packages, vehicle kits, cosmetics, progression, identity, teleports, water, augments, and guarded destructive work. Database writes use explicit offline or live-state checks rather than optimistic guesses.",
  },
  {
    id: "solo",
    title: "Solo Mode",
    img: "solo-mode.png",
    body: "Manage one local Dune Solo save without a VM or Self-Hosted installation. DST validates the wrapped SQLite save, keeps retained backups, and exposes typed settings plus inventory, currency, water, cosmetics, packages, vehicle kits, augments, and proven progression actions. Mutations require the game to be closed and are backup-first, atomic, and verified.",
  },
  {
    id: "maps",
    title: "DD Seed Maps",
    img: "dd-seed-maps.png",
    body: "Explore all 12 Deep Desert Coriolis layouts without leaving DST. Each seed has a labeled grid, POI counts, confidence notes, and filters for caves, wrecks, testing stations, large spice fields, taxis, Titanium, and Stravidium. DST also distinguishes the next farm seed from the seed currently running in Deep Desert.",
  },
  {
    id: "database",
    title: "Database",
    img: "database.png",
    body: "Back up, restore, import, mirror, inspect, and query the battlegroup PostgreSQL database without tracking pod names. Scheduled backups live on the VM, SQL starts read-only, and restore guidance calls out Deep Desert safety. The guarded World Restart workflow can preserve the battlegroup while rebuilding its world database from scratch.",
  },
  {
    id: "settings",
    title: "Settings",
    img: "settings.png",
    body: "Keep installation, updates, appearance, warnings, Remote Access, Hyper-V over LAN, Public IP/DDNS, browser ping, and mobile pairing in one place. Host credentials stay in Windows Credential Manager, remote surfaces are deliberately constrained, and the install path is visible for antivirus exclusions and troubleshooting.",
  },
];
---

<Base
  title="Features — DST"
  description="A page-by-page tour of the Dune Server Tool portal."
>
  <PageHeader
    eyebrow="Tour"
    title="Seven surfaces that do the work"
    intro="A current tour of DST's core Self-Hosted and Solo workflows, captured from the live app with documentation-safe demo identities."
  />

  <section class="mx-auto max-w-6xl px-6 pb-20 space-y-20">
    {
      sections.map((s, i) => (
        <div
          id={s.id}
          class={`grid md:grid-cols-2 gap-8 items-center ${i % 2 ? "md:[&>:first-child]:order-2" : ""}`}
        >
          <Screenshot src={`${base}screenshots/${s.img}`} alt={s.title} />
          <div>
            <h2 class="text-2xl font-semibold text-dune-text mb-3">
              {s.title}
            </h2>
            <p class="text-dune-muted leading-relaxed">{s.body}</p>
          </div>
        </div>
      ))
    }
  </section>
</Base>
